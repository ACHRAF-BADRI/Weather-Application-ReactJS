# Copy this file to .env and fill in your values.
# .env is git-ignored: your keys never end up on GitHub.

# Required: get a free key at https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=your_weatherapi_key_here

# Optional: enables AI-written weather insights via Groq (https://console.groq.com)
# Leave empty to use the built-in rule-based insights only.
GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b

# Contact form → email (optional). Create a free account at https://resend.com,
# then API Keys > Create. Without a verified domain, Resend can only deliver to the
# email address you signed up with, so use that address for CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# With your own verified domain on Resend you can set a custom sender:
# CONTACT_FROM_EMAIL=Weather App <contact@your-domain.com>

# Front-end origins allowed to call this API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# PORT=4000
