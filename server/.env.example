# Copy this file to .env and fill in your values.
# .env is git-ignored: your keys never end up on GitHub.

# Required: get a free key at https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=your_weatherapi_key_here

# Optional: enables Claude-written weather insights (https://console.anthropic.com)
# Leave empty to use the built-in rule-based insights only.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Front-end origins allowed to call this API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# PORT=4000
